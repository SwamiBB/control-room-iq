# Azure (leave empty + CRQ_OFFLINE=1 to run fully local)
CRQ_OFFLINE=1
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
AZURE_OPENAI_ENDPOINT=https://<account>.openai.azure.com/
ROUTER_QUALITY=router-quality
ROUTER_BALANCED=router-balanced
ROUTER_COST=router-cost
MODEL_FALLBACK_DEPLOYMENT=gpt-4.1-mini
EVENTHUB_NAMESPACE=evhns-crq-<env>-eastus2-01.servicebus.windows.net
EVENTHUB_EVENTS=crq-events
EVENTHUB_MOMENTS=crq-moments
EVENTHUB_OVERLAY=crq-overlay
COSMOS_ENDPOINT=https://cosmos-crq-<env>-eastus2-01.documents.azure.com:443/
COSMOS_DB=crq
SPEECH_REGION=eastus2
# Tracing (agents/telemetry.py) is off while this is empty: leave it empty locally, so laptop runs don't mix into
# the demo's traces. Set in Azure by Bicep. The resource takes Entra ID only, so a local run that sets it also needs
# the Monitoring Metrics Publisher role on it.
APPLICATIONINSIGHTS_CONNECTION_STRING=
# Prompt and response text in the trace spans. On for the hosted demo (synthetic data); off for real viewer data.
CRQ_TRACE_CONTENT=false
CRQ_LANGS=en,es,hi
AGENT_TIMEOUT_S=12
AGENT_REASONING_EFFORT=low
# Local runs only: sign in with your `az login`. Without it, DefaultAzureCredential can stop at a broken
# shared token cache before it reaches the Azure CLI. Leave unset in Azure, where the managed identity is used.
# AZURE_TOKEN_CREDENTIALS=AzureCliCredential   (needs azure-identity 1.24 or later)
